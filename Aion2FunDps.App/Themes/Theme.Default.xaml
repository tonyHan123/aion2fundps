<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================
         Theme: Default (Dark + Cyan/Gold)
         ========================================================================
         The original meter palette. Deep ink-navy ground, soft cream body,
         restrained gold accent for content markers (dungeon name, focused
         boss), pale cyan for the DPS column. Avoids pure white and saturated
         orange — those read as "amateur dashboard" against Aion 2's warm UI.

         Theme contract: every key here MUST be defined in every other theme
         (Theme.SweetPastel.xaml etc.) so DynamicResource lookups resolve in
         all themes. Keep keys aligned.
         ======================================================================== -->

    <!-- Surfaces (window / panels / dividers) -->
    <SolidColorBrush x:Key="BgBrush"            Color="#E60B0F18"/>
    <SolidColorBrush x:Key="TitleBarBrush"      Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush"       Color="#14FFFFFF"/>

    <!-- Typography colors -->
    <SolidColorBrush x:Key="TextBrush"          Color="#E5E7EB"/>
    <SolidColorBrush x:Key="MutedBrush"         Color="#7E94B0"/>

    <!-- Content accents -->
    <SolidColorBrush x:Key="GoldBrush"          Color="#E5C97A"/>
    <SolidColorBrush x:Key="GoldDimBrush"       Color="#A89058"/>
    <!-- 전투력 컬럼 전용 색. 다크 테마에서는 골드 톤이 잘 식별됨. -->
    <SolidColorBrush x:Key="CombatPowerBrush"   Color="#E5C97A"/>
    <!-- DPS 컬럼 전용. 다크 테마에서는 시안이 가장 강조됨. -->
    <SolidColorBrush x:Key="DpsBrush"           Color="#7DD3FC"/>
    <SolidColorBrush x:Key="CyanBrush"          Color="#7DD3FC"/>
    <SolidColorBrush x:Key="AmberBrush"         Color="#F4A640"/>
    <SolidColorBrush x:Key="AmberSoftBrush"     Color="#1AF4A640"/>

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Pretendard, Malgun Gothic, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Row + section surface overlays. Subtle white-alpha against the dark BG. -->
    <SolidColorBrush x:Key="RowOverlayBrush"      Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="SectionOverlayBrush"  Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="FooterOverlayBrush"   Color="#0AFFFFFF"/>

    <!-- Per-row signature colors. Self = green leak on dark; primary guess = cyan. -->
    <SolidColorBrush x:Key="SelfAccentBrush"          Color="#22C55E"/>
    <SolidColorBrush x:Key="PrimaryGuessAccentBrush"  Color="#7DD3FC"/>
    <LinearGradientBrush x:Key="SelfRowBgBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#3322C55E" Offset="0"/>
        <GradientStop Color="#1422C55E" Offset="0.45"/>
        <GradientStop Color="#0822C55E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGuessRowBgBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#2E7DD3FC" Offset="0"/>
        <GradientStop Color="#127DD3FC" Offset="0.45"/>
        <GradientStop Color="#067DD3FC" Offset="1"/>
    </LinearGradientBrush>

    <!-- Damage bar fill (Bar A — 누적 비율). Bright blue on dark theme. -->
    <SolidColorBrush x:Key="DamageBarBrush" Color="#553B82F6"/>
    <!-- 본인 행 전용 막대 색 (Self overrides DamageBarBrush via DataTrigger). 녹색.
         사용자가 자기 행을 한눈에 식별하도록 색을 분리. -->
    <SolidColorBrush x:Key="SelfDamageBarBrush"     Color="#5522C55E"/>
    <SolidColorBrush x:Key="SelfDamageBarEdgeBrush" Color="#CC22C55E"/>
    <SolidColorBrush x:Key="SelfDpsLineBrush"       Color="#E022C55E"/>

    <!-- Glass Track Meter (v0.1.2):
         Bar A 외곽 막대는 누적 데미지 비율, Bar B 안쪽 라인은 현재 DPS 강도.
         Glass track 은 row 안쪽 inset 컨테이너. -->
    <SolidColorBrush x:Key="GlassTrackBgBrush"        Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="GlassTrackBorderBrush"    Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="DamageBarEdgeBrush"       Color="#AA7DB8FF"/>
    <SolidColorBrush x:Key="DpsIntensityLineBrush"    Color="#E07DD3FC"/>
    <SolidColorBrush x:Key="TrailingGlowBrush"        Color="#557DB8FF"/>
    <!-- Podium 좌측 stripe brushes for ranks 1/2/3. 4·5등+ 는 stripe 없음.
         Self / primary-guess stripe 가 우선 (rank stripe 를 덮음). -->
    <SolidColorBrush x:Key="PodiumGoldBrush"    Color="#FFD66B"/>
    <SolidColorBrush x:Key="PodiumSilverBrush"  Color="#D6DCE5"/>
    <SolidColorBrush x:Key="PodiumBronzeBrush"  Color="#D08A4B"/>

    <!-- Rank-별 시각 식별 막대 (Bar A) + edge highlight.
         deep navy 배경에 대비되는 밝은 채도 8색. alpha 0x55 (bar) / 0xCC (edge). -->
    <SolidColorBrush x:Key="RankBar1Brush"      Color="#55FFD66B"/>
    <SolidColorBrush x:Key="RankBar1EdgeBrush"  Color="#CCFFD66B"/>
    <SolidColorBrush x:Key="RankBar2Brush"      Color="#555BC0DE"/>
    <SolidColorBrush x:Key="RankBar2EdgeBrush"  Color="#CC5BC0DE"/>
    <SolidColorBrush x:Key="RankBar3Brush"      Color="#55F06292"/>
    <SolidColorBrush x:Key="RankBar3EdgeBrush"  Color="#CCF06292"/>
    <SolidColorBrush x:Key="RankBar4Brush"      Color="#559CCC65"/>
    <SolidColorBrush x:Key="RankBar4EdgeBrush"  Color="#CC9CCC65"/>
    <SolidColorBrush x:Key="RankBar5Brush"      Color="#55FF8A65"/>
    <SolidColorBrush x:Key="RankBar5EdgeBrush"  Color="#CCFF8A65"/>
    <SolidColorBrush x:Key="RankBar6Brush"      Color="#55BA68C8"/>
    <SolidColorBrush x:Key="RankBar6EdgeBrush"  Color="#CCBA68C8"/>
    <SolidColorBrush x:Key="RankBar7Brush"      Color="#55FFEE58"/>
    <SolidColorBrush x:Key="RankBar7EdgeBrush"  Color="#CCFFEE58"/>
    <SolidColorBrush x:Key="RankBar8Brush"      Color="#5590A4AE"/>
    <SolidColorBrush x:Key="RankBar8EdgeBrush"  Color="#CC90A4AE"/>

    <!-- Logo (AION2FUN wordmark) — cool blue family. -->
    <LinearGradientBrush x:Key="LogoMainBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"   Color="#F2FAFF"/>
        <GradientStop Offset="0.55" Color="#B8DEFF"/>
        <GradientStop Offset="1"   Color="#6FA8E6"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoAccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#7CC8FF"/>
        <GradientStop Offset="1" Color="#1E66D8"/>
    </LinearGradientBrush>
    <Color x:Key="LogoGlowColor">#3D8BFF</Color>

</ResourceDictionary>
