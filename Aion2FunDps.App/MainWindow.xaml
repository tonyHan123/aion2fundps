<Window x:Class="Aion2FunDps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aion2FunDps.UI.ViewModels;assembly=Aion2FunDps.UI"
        xmlns:ui="clr-namespace:Aion2FunDps.UI;assembly=Aion2FunDps.UI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="aion2fundps"
        Width="460" Height="320"
        MinWidth="380" MinHeight="60"
        MaxWidth="900" MaxHeight="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        Opacity="{Binding WindowOpacity}"
        TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ResetSessionCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ui:HexColorToBrushConverter x:Key="HexToBrush"/>
        <!-- Palette derived from the in-game stat panel: deep ink-navy
             ground, soft cream body, restrained gold accent for content
             markers (dungeon name, boss focus), pale cyan accent for the
             DPS column. Avoid pure white and saturated orange — they
             read as "amateur dashboard" against the warm in-game UI. -->
        <SolidColorBrush x:Key="BgBrush" Color="#E60B0F18"/>
        <SolidColorBrush x:Key="TitleBarBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7E94B0"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#E5C97A"/>
        <SolidColorBrush x:Key="GoldDimBrush" Color="#A89058"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#F4A640"/>
        <SolidColorBrush x:Key="AmberSoftBrush" Color="#1AF4A640"/>
        <FontFamily x:Key="UiFont">Pretendard, Malgun Gothic, Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    </Window.Resources>

    <Border x:Name="OuterBorder"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="LeaderboardRow" Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar (drag) -->
            <Border Grid.Row="0" Padding="12,7"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <DockPanel>
                    <TextBlock Text="aion2fundps"
                               FontFamily="{StaticResource UiFont}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="🌗"
                                   ToolTip="투명도 (왼쪽일수록 투명)"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <Slider Width="80"
                                Minimum="0.2" Maximum="1.0"
                                SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding WindowOpacity, Mode=TwoWay}"
                                ToolTip="투명도 (왼쪽일수록 투명)"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <Button x:Name="MarkBtn" Content="⚑ 0" Click="MarkBtn_Click"
                                ToolTip="이벤트 마크 — 입장/퇴장/관찰 시점에 클릭하면 시각이 user-marks.log에 기록됨"
                                MinWidth="38" Height="22" Padding="4,0"
                                Background="Transparent"
                                Foreground="#FACC15" BorderThickness="0"
                                FontSize="11" FontWeight="Bold"/>
                        <Button Content="↻" Command="{Binding ResetSessionCommand}"
                                ToolTip="세션 리셋 (Ctrl+R)"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                FontSize="14" FontWeight="Bold"/>
                        <Button Content="—" Click="MinBtn_Click"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                FontSize="13"/>
                        <Button Content="✕" Click="CloseBtn_Click"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                FontSize="13"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Auto-reset flash banner (briefly visible after boss detection) -->
            <Border Grid.Row="1" Padding="0"
                    Background="{StaticResource AmberSoftBrush}"
                    Visibility="{Binding ShowAutoResetFlash, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="{StaticResource AmberBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="보스 감지 — 세션 자동 리셋"
                               Padding="10,5"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AmberBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Confidence + boss banner combined.
                 Hidden while auto-reset flash is showing so the two Row 1 borders
                 don't visually overlap during the brief flash window. -->
            <Border Grid.Row="1" Padding="12,5"
                    Background="#08FFFFFF"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsContentVisible}" Value="True"/>
                                    <Condition Binding="{Binding ShowAutoResetFlash}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Confidence (left): only shown while a boss fight is being measured.
                         Hides during idle/town to avoid showing meaningless drift wobble. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                ToolTip="{Binding ConfidenceIssues}"
                                Visibility="{Binding IsConfidenceVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="신뢰도"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="11"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfidenceEmoji}"
                                   FontSize="11"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfidenceScore, StringFormat={}{0:P0}}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Boss name + HP (right). Refined gold matches the in-game
                         stat panel content-marker tone; the previous saturated
                         orange clashed against the deep BG. -->
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Margin="20,0,0,0"
                               Text="{Binding FocusInfo}"
                               Foreground="{StaticResource GoldBrush}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsBossMode, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- Column headers — aligned with data rows in Row 3 (same column widths) -->
            <Border Grid.Row="2" Padding="14,6,14,5"
                    Background="#0DFFFFFF"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <!-- Dungeon name: refined gold + tracking. Reads as a content
                         marker rather than a screaming highlight. The thin
                         left bar visually anchors it next to the column area. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasDungeon, Converter={StaticResource BoolToVis}}">
                        <Rectangle Width="2" Height="11"
                                   Fill="{StaticResource CyanBrush}"
                                   Opacity="0.7"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentDungeonName}"
                                   Foreground="{StaticResource CyanBrush}"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Opacity="0.95"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="전투력"
                               Foreground="{StaticResource MutedBrush}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="누적 딜량"
                               Foreground="{StaticResource MutedBrush}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="DPS"
                               Foreground="{StaticResource CyanBrush}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right"
                               Opacity="0.95"/>
                    <TextBlock Grid.Column="5" Text="지분율"
                               Foreground="{StaticResource MutedBrush}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Leaderboard -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="6,4"
                          Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Players}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32" Margin="0,1">
                                <!-- Row background: subtle base tint, with a
                                     left-fading green wash for the user's own
                                     row and cyan wash for primary-guess (until
                                     self is confirmed). The accent reads as a
                                     light leak from the left edge instead of a
                                     full block highlight, so the row stays
                                     legible against the deep BG. -->
                                <Border CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#08FFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                <GradientStop Color="#3322C55E" Offset="0"/>
                                                                <GradientStop Color="#1422C55E" Offset="0.45"/>
                                                                <GradientStop Color="#0822C55E" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPrimaryGuess}" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                <GradientStop Color="#2E7DD3FC" Offset="0"/>
                                                                <GradientStop Color="#127DD3FC" Offset="0.45"/>
                                                                <GradientStop Color="#067DD3FC" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <!-- Left accent bar — solid 2px in the row's
                                     signature color. Renders OVER the rounded
                                     background so it sits flush with the left
                                     edge; visibility is data-bound so it only
                                     shows on self / primary-guess rows. -->
                                <Rectangle Width="2"
                                           HorizontalAlignment="Left"
                                           Margin="0,2,0,2"
                                           RadiusX="1" RadiusY="1">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Fill" Value="#22C55E"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPrimaryGuess}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Fill" Value="#7DD3FC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#553B82F6" CornerRadius="3"
                                            HorizontalAlignment="Left">
                                        <Border.Width>
                                            <Binding Path="DamageBarPercent"
                                                     RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                        </Border.Width>
                                    </Border>
                                </Grid>
                                <Grid Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding TopSkillsTooltip}">
                                        <Image Source="{Binding ClassIcon}"
                                               Width="24" Height="24"
                                               Margin="0,0,7,0"
                                               VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="Fant">
                                            <Image.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="4"
                                                                  ShadowDepth="0" Opacity="0.85"/>
                                            </Image.Effect>
                                        </Image>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontFamily="{StaticResource UiFont}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- [me] tag removed: the left accent
                                             bar + gradient row tint already
                                             communicates self / primary-guess
                                             status, so the textual marker was
                                             redundant against the new design. -->
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding CombatPowerDisplay}"
                                               Foreground="{StaticResource GoldBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               ToolTip="전투력"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalDamage, StringFormat=N0}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Dps, StringFormat=N0}"
                                               Foreground="{StaticResource CyanBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               Opacity="0.92"/>
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding DamageSharePercent, StringFormat={}{0:F1}%}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="4" Padding="10,4" Background="#0AFFFFFF"
                    Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#22C55E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TickIndicator}" Value="True">
                                        <Setter Property="Fill" Value="#22C55E"/>
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TickIndicator}" Value="False">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <CheckBox IsChecked="{Binding AutoResetOnBoss}"
                              Content="보스 자동리셋"
                              ToolTip="보스 잡거나 와이프 시 결과 화면 그대로 유지. 다음 보스(또는 같은 보스 재도전)를 처음 타격하는 순간 자동 리셋되어 새 누적 시작. 60초 무전투도 안전망으로 리셋."
                              Foreground="{StaticResource MutedBrush}"
                              FontFamily="{StaticResource UiFont}"
                              FontSize="11" VerticalAlignment="Center"
                              DockPanel.Dock="Right"/>
                    <TextBlock Text="" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
