<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Aion2FunDps.Capture\Aion2FunDps.Capture.csproj" />
    <ProjectReference Include="..\Aion2FunDps.Protocol\Aion2FunDps.Protocol.csproj" />
    <ProjectReference Include="..\Aion2FunDps.Core\Aion2FunDps.Core.csproj" />
    <ProjectReference Include="..\Aion2FunDps.Storage\Aion2FunDps.Storage.csproj" />
    <ProjectReference Include="..\Aion2FunDps.UI\Aion2FunDps.UI.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>0.1.0-alpha</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>aion2fundps</Product>
    <Company>tonyHan123</Company>
    <Copyright>© 2026 tonyHan123 — MIT License</Copyright>
    <!-- IncludeNativeLibrariesForSelfExtract is left at the default
         (true) because IncludeAllContentForSelfExtract=true (set in
         build-release.ps1 stage 3) requires the native flag to also
         be true — .NET SDK error NETSDK1143 enforces the pairing.
         Net effect: Aion2FunDps.Engine.dll is bundled inside the
         single-file .exe and extracted to a per-user temp dir on
         first launch via the .NET single-file extraction mechanism.
         The Win32 LoadLibrary search order then finds it from there.
         If antivirus false-positives on the temp-extracted DLL
         become a real distribution issue post-alpha, we can revisit
         by dropping IncludeAllContentForSelfExtract and shipping
         Asset/Data as loose dirs in a zip alongside the .exe + .dll. -->
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\ClassIcons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Logo\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Aion2FunDps.Storage\Data\mobs.json"            Link="Data\mobs.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Aion2FunDps.Storage\Data\skills.json"          Link="Data\skills.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Aion2FunDps.Storage\Data\dungeons.json"        Link="Data\dungeons.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Aion2FunDps.Storage\Data\buff_blacklist.json"  Link="Data\buff_blacklist.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Aion2FunDps.Storage\Data\buff_custom.json"     Link="Data\buff_custom.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Aion2FunDps.Storage\Data\NOTICE.md"            Link="Data\NOTICE.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\THIRD_PARTY_NOTICES.txt"                       Link="THIRD_PARTY_NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Native engine DLL deployment. The C++ project Aion2FunDps.Engine.vcxproj
       builds Aion2FunDps.Engine.dll separately (msbuild on the .vcxproj);
       this Content include copies it next to Aion2FunDps.App.exe so the
       P/Invoke layer in NativeEngineDispatcher can load it via the Win32
       LoadLibrary search order. Conditioned on existence so dotnet build
       still succeeds before the C++ project has been built once.
       Why <Content> not <None>: <None> with CopyToOutputDirectory copies
       to bin/.../net10.0-windows/win-x64/ but NOT into bin/.../publish/,
       so single-file release builds drop the native DLL silently and
       fail on first dispatch when UseNativeEngine=true. <Content> +
       CopyToPublishDirectory routes through both build and publish.
       The native runtime then extracts it from the self-extracting
       bundle to the per-app temp dir on first launch (enabled via
       IncludeAllContentForSelfExtract=true in build-release.ps1). -->
  <ItemGroup>
    <Content Include="..\Aion2FunDps.Engine\bin\$(Configuration)\Aion2FunDps.Engine.dll"
             Condition="Exists('..\Aion2FunDps.Engine\bin\$(Configuration)\Aion2FunDps.Engine.dll')">
      <Link>Aion2FunDps.Engine.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Aion2FunDps.Engine\bin\$(Configuration)\Aion2FunDps.Engine.pdb"
             Condition="Exists('..\Aion2FunDps.Engine\bin\$(Configuration)\Aion2FunDps.Engine.pdb')">
      <Link>Aion2FunDps.Engine.pdb</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
