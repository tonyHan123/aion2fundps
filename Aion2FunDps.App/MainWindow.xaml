<Window x:Class="Aion2FunDps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aion2FunDps.UI.ViewModels;assembly=Aion2FunDps.UI"
        xmlns:ui="clr-namespace:Aion2FunDps.UI;assembly=Aion2FunDps.UI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="aion2fundps"
        Width="460" Height="320"
        MinWidth="380" MinHeight="60"
        MaxWidth="900" MaxHeight="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        Opacity="{Binding WindowOpacity}"
        TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <!-- WindowChrome restores the OS-level edge resize hit zones that
         WindowStyle=None + AllowsTransparency=True strips away. With this,
         hovering over a window edge changes the cursor to ↔ / ↕ / ⤡ and
         dragging resizes — same as a normal Windows window. CaptionHeight=0
         because we have our own custom titlebar (drag handler) and don't
         want WindowChrome's auto-drag interfering with it. UseAeroCaptionButtons
         off + GlassFrameThickness=0 because we draw our own ✕ / ⚙ / etc. -->
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="6"
                      CaptionHeight="0"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Hotkeys are bound at runtime by ApplyHotkeys() (MainWindow.xaml.cs)
         from AppSettings, so the user can rebind them via the settings panel
         without restarting the app. -->

    <Window.Resources>
        <!-- Theme brushes / fonts live in Application.Resources via
             /Themes/Theme.{themeId}.xaml — see App.xaml. ThemeManager
             swaps that at runtime; DynamicResource lookups in this window
             walk up to the application scope and pick up the active theme.
             Window-local resources are only the static converters. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ui:HexColorToBrushConverter x:Key="HexToBrush"/>
    </Window.Resources>

    <Border x:Name="OuterBorder"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="LeaderboardRow" Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar (drag) -->
            <Border Grid.Row="0" Padding="2,7,12,7"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <DockPanel>
                    <Image DockPanel.Dock="Left"
                           Source="/Assets/Logo/logo-icon.png"
                           Width="22" Height="22"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="Fant"/>
                    <!-- Game-logo-styled wordmark. WPF text + gradient brush +
                         tiny static DropShadowEffect for the "glowing letters"
                         feel of the source image. The shadow is OK on a static
                         element (renders once, not per-frame); the per-row
                         icon shadow we removed was per-frame. -->
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontFamily="Impact"
                               FontSize="16"
                               FontWeight="Bold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource LogoGlowColor}"
                                              BlurRadius="8"
                                              ShadowDepth="0" Opacity="0.55"/>
                        </TextBlock.Effect>
                        <Run Text="AION" Foreground="{DynamicResource LogoMainBrush}"/><Run Text="2" FontSize="18" Foreground="{DynamicResource LogoAccentBrush}"/><Run Text="FUN" Foreground="{DynamicResource LogoMainBrush}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="🌗"
                                   ToolTip="투명도 (왼쪽일수록 투명)"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <Slider Width="80"
                                Minimum="0.2" Maximum="1.0"
                                SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding WindowOpacity, Mode=TwoWay}"
                                ToolTip="투명도 (왼쪽일수록 투명)"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <Button x:Name="MarkBtn" Content="📌" Click="MarkBtn_Click"
                                ToolTip="타임스탬프 기록 (디버그용 — 게임 중 이상 시점 표시)"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontSize="13"/>
                        <Button Content="⚙" Click="SettingsBtn_Click"
                                ToolTip="설정 (테마 / 표시 옵션)"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontSize="14"/>
                        <Button Content="↻" Command="{Binding ResetSessionCommand}"
                                ToolTip="세션 리셋 (Ctrl+R)"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontSize="14" FontWeight="Bold"/>
                        <Button Content="—" Click="MinBtn_Click"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontSize="13"/>
                        <Button Content="✕" Click="CloseBtn_Click"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontSize="13"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Auto-reset flash banner (briefly visible after boss detection) -->
            <Border Grid.Row="1" Padding="0"
                    Background="{DynamicResource AmberSoftBrush}"
                    Visibility="{Binding ShowAutoResetFlash, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="{DynamicResource AmberBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="보스 감지 — 세션 자동 리셋"
                               Padding="10,5"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AmberBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Confidence + boss banner combined.
                 Hidden while auto-reset flash is showing so the two Row 1 borders
                 don't visually overlap during the brief flash window. -->
            <Border Grid.Row="1" Padding="12,5"
                    Background="{DynamicResource RowOverlayBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsContentVisible}" Value="True"/>
                                    <Condition Binding="{Binding ShowAutoResetFlash}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Confidence (left): only shown while a boss fight is being measured.
                         Hides during idle/town to avoid showing meaningless drift wobble. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                ToolTip="{Binding ConfidenceIssues}"
                                Visibility="{Binding IsConfidenceVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="신뢰도"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="11"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfidenceEmoji}"
                                   FontSize="11"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfidenceScore, StringFormat={}{0:P0}}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Boss name + HP (right). Refined gold matches the in-game
                         stat panel content-marker tone; the previous saturated
                         orange clashed against the deep BG. -->
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Margin="20,0,0,0"
                               Text="{Binding FocusInfo}"
                               Foreground="{DynamicResource GoldBrush}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsBossMode, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- Column headers — aligned with data rows in Row 3 (same column widths) -->
            <Border Grid.Row="2" Padding="14,6,14,5"
                    Background="{DynamicResource SectionOverlayBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <!-- Dungeon name: refined gold + tracking. Reads as a content
                         marker rather than a screaming highlight. The thin
                         left bar visually anchors it next to the column area. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasDungeon, Converter={StaticResource BoolToVis}}">
                        <Rectangle Width="2" Height="11"
                                   Fill="{DynamicResource CyanBrush}"
                                   Opacity="0.7"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentDungeonName}"
                                   Foreground="{DynamicResource CyanBrush}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Opacity="0.95"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="전투력"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="누적 딜량"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="DPS"
                               Foreground="{DynamicResource CyanBrush}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right"
                               Opacity="0.95"/>
                    <TextBlock Grid.Column="5" Text="지분율"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Leaderboard -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="6,4"
                          Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Players}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32" Margin="0,1"
                                  Background="Transparent"
                                  MouseLeftButtonUp="PlayerRow_Click"
                                  Cursor="Hand"
                                  ToolTip="클릭 — 스킬 상세 보기">
                                <!-- Row background: subtle base tint, with a
                                     left-fading green wash for the user's own
                                     row and cyan wash for primary-guess (until
                                     self is confirmed). The accent reads as a
                                     light leak from the left edge instead of a
                                     full block highlight, so the row stays
                                     legible against the deep BG. -->
                                <Border CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource RowOverlayBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelfRowBgBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPrimaryGuess}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryGuessRowBgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <!-- Left accent bar — solid 2px in the row's
                                     signature color. Renders OVER the rounded
                                     background so it sits flush with the left
                                     edge; visibility is data-bound so it only
                                     shows on self / primary-guess rows. -->
                                <Rectangle Width="2"
                                           HorizontalAlignment="Left"
                                           Margin="0,2,0,2"
                                           RadiusX="1" RadiusY="1">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Fill" Value="{DynamicResource SelfAccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPrimaryGuess}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Fill" Value="{DynamicResource PrimaryGuessAccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource DamageBarBrush}" CornerRadius="3"
                                            HorizontalAlignment="Left">
                                        <Border.Width>
                                            <Binding Path="DamageBarPercent"
                                                     RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                        </Border.Width>
                                    </Border>
                                </Grid>
                                <Grid Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding TopSkillsTooltip}">
                                        <!-- DropShadowEffect was removed for performance: WPF software-rendered
                                             shadows cost GPU per frame and competes with game rendering. The icons
                                             read fine against the meter's translucent background without one. -->
                                        <Image Source="{Binding ClassIcon}"
                                               Width="24" Height="24"
                                               Margin="0,0,7,0"
                                               VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="Fant"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="{DynamicResource UiFont}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- [me] tag removed: the left accent
                                             bar + gradient row tint already
                                             communicates self / primary-guess
                                             status, so the textual marker was
                                             redundant against the new design. -->
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding CombatPowerDisplay}"
                                               Foreground="{DynamicResource GoldBrush}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               ToolTip="전투력"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalDamage, StringFormat=N0}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Dps, StringFormat=N0}"
                                               Foreground="{DynamicResource CyanBrush}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               Opacity="0.92"/>
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding DamageSharePercent, StringFormat={}{0:F1}%}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="4" Padding="10,4" Background="{DynamicResource FooterOverlayBrush}"
                    Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SelfAccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TickIndicator}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SelfAccentBrush}"/>
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TickIndicator}" Value="False">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <CheckBox IsChecked="{Binding AutoResetOnBoss}"
                              Content="보스 자동리셋"
                              ToolTip="보스 잡거나 와이프 시 결과 화면 그대로 유지. 다음 보스(또는 같은 보스 재도전)를 처음 타격하는 순간 자동 리셋되어 새 누적 시작. 60초 무전투도 안전망으로 리셋."
                              Foreground="{DynamicResource MutedBrush}"
                              FontFamily="{DynamicResource UiFont}"
                              FontSize="11" VerticalAlignment="Center"
                              DockPanel.Dock="Right"/>
                    <TextBlock Text="" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
