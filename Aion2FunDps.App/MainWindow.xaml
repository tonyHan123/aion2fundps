<Window x:Class="Aion2FunDps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aion2FunDps.UI.ViewModels;assembly=Aion2FunDps.UI"
        xmlns:ui="clr-namespace:Aion2FunDps.UI;assembly=Aion2FunDps.UI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="aion2fundps"
        Width="420" Height="340"
        MinWidth="360" MinHeight="60"
        MaxWidth="900" MaxHeight="900"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        Opacity="{Binding WindowOpacity}"
        TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <!-- WindowChrome restores the OS-level edge resize hit zones that
         WindowStyle=None + AllowsTransparency=True strips away. With this,
         hovering over a window edge changes the cursor to ↔ / ↕ / ⤡ and
         dragging resizes — same as a normal Windows window. CaptionHeight=0
         because we have our own custom titlebar (drag handler) and don't
         want WindowChrome's auto-drag interfering with it. UseAeroCaptionButtons
         off + GlassFrameThickness=0 because we draw our own ✕ / ⚙ / etc. -->
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="6"
                      CaptionHeight="0"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Hotkeys are bound at runtime by ApplyHotkeys() (MainWindow.xaml.cs)
         from AppSettings, so the user can rebind them via the settings panel
         without restarting the app. -->

    <Window.Resources>
        <!-- Theme brushes / fonts live in Application.Resources via
             /Themes/Theme.{themeId}.xaml — see App.xaml. ThemeManager
             swaps that at runtime; DynamicResource lookups in this window
             walk up to the application scope and pick up the active theme.
             Window-local resources are only the static converters. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ui:HexColorToBrushConverter x:Key="HexToBrush"/>
        <ui:RankToBarBrushConverter x:Key="RankToBarBrush"/>
        <ui:RankToEdgeBrushConverter x:Key="RankToEdgeBrush"/>
        <ui:PercentToWidthConverter x:Key="PercentToWidth"/>
    </Window.Resources>

    <Border x:Name="OuterBorder"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="LeaderboardRow" Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar (drag) -->
            <Border Grid.Row="0" Padding="2,7,12,7"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <DockPanel>
                    <Image DockPanel.Dock="Left"
                           Source="/Assets/Logo/logo-icon.png"
                           Width="22" Height="22"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="Fant"/>
                    <!-- Game-logo-styled wordmark. WPF text + gradient brush +
                         tiny static DropShadowEffect for the "glowing letters"
                         feel of the source image. The shadow is OK on a static
                         element (renders once, not per-frame); the per-row
                         icon shadow we removed was per-frame. -->
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontFamily="Impact"
                               FontSize="16"
                               FontWeight="Bold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource LogoGlowColor}"
                                              BlurRadius="8"
                                              ShadowDepth="0" Opacity="0.55"/>
                        </TextBlock.Effect>
                        <Run Text="AION" Foreground="{DynamicResource LogoMainBrush}"/><Run Text="2" FontSize="18" Foreground="{DynamicResource LogoAccentBrush}"/><Run Text="FUN" Foreground="{DynamicResource LogoMainBrush}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE706;"
                                   ToolTip="투명도 (왼쪽일수록 투명)"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <Slider Width="80"
                                Minimum="0.2" Maximum="1.0"
                                SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding WindowOpacity, Mode=TwoWay}"
                                ToolTip="투명도 (왼쪽일수록 투명)"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <Button x:Name="UpdateBtn" Click="UpdateBtn_Click"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding UpdateVersionLabel, StringFormat=새 버전 {0} — 클릭하여 다운로드}"
                                Height="22" Padding="6,0" Background="Transparent"
                                Foreground="{DynamicResource AmberBrush}" BorderThickness="0"
                                FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="&#xE7E7;" FontFamily="Segoe MDL2 Assets"/><Run Text="  "/><Run Text="{Binding UpdateVersionLabel}"/>
                            </TextBlock>
                        </Button>
                        <Button x:Name="MarkBtn" Content="&#xE840;" Click="MarkBtn_Click"
                                ToolTip="타임스탬프 기록 (디버그용 — 게임 중 이상 시점 표시)"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        <Button Content="&#xE713;" Click="SettingsBtn_Click"
                                ToolTip="설정 (테마 / 표시 옵션)"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        <Button Content="&#xE72C;" Command="{Binding ResetSessionCommand}"
                                ToolTip="세션 리셋 (Ctrl+R)"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        <Button Content="&#xE921;" Click="MinBtn_Click"
                                ToolTip="컴팩트 모드 토글 (타이틀바만 남기기)"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        <Button Content="&#xE711;" Click="CloseBtn_Click"
                                ToolTip="종료"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Auto-reset flash banner (briefly visible after boss detection) -->
            <Border Grid.Row="1" Padding="0"
                    Background="{DynamicResource AmberSoftBrush}"
                    Visibility="{Binding ShowAutoResetFlash, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="{DynamicResource AmberBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="보스 감지 — 세션 자동 리셋"
                               Padding="10,5"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AmberBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Confidence + boss banner combined.
                 Hidden while auto-reset flash is showing so the two Row 1 borders
                 don't visually overlap during the brief flash window. -->
            <Border Grid.Row="1" Padding="12,5"
                    Background="{DynamicResource RowOverlayBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsContentVisible}" Value="True"/>
                                    <Condition Binding="{Binding ShowAutoResetFlash}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Confidence (left): only shown while a boss fight is being measured.
                         Hides during idle/town to avoid showing meaningless drift wobble. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                ToolTip="{Binding ConfidenceIssues}"
                                Visibility="{Binding IsConfidenceVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="신뢰도"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="11"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfidenceEmoji}"
                                   FontSize="11"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfidenceScore, StringFormat={}{0:P0}}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Boss name + HP (right). Refined gold matches the in-game
                         stat panel content-marker tone; the previous saturated
                         orange clashed against the deep BG. -->
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Margin="20,0,0,0"
                               Text="{Binding FocusInfo}"
                               Foreground="{DynamicResource GoldBrush}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsBossMode, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- Column headers — aligned with data rows in Row 3 (same column widths).
                 New v0.1.1 DPS-primary layout: drop 누적/전투력 columns from the
                 header bar to let the dungeon name breathe; the per-row template
                 keeps a compact 전투력 + 누적 in a secondary font weight so the
                 numbers are still glanceable without competing with DPS. -->
            <!-- Column headers — 컬럼 너비 + 폰트군이 데이터 행과 정확히 일치해야 시각적으로 정렬됨.
                 Padding=12 = ScrollViewer.Padding(6) + Row Grid Margin(6) 합산.
                 Font = MonoFont = 데이터 행과 동일 → 자릿수 정렬이 픽셀 단위로 맞음. -->
            <Border Grid.Row="2" Padding="12,5,12,4"
                    Background="{DynamicResource SectionOverlayBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <!-- 그룹 구조:
                       왼쪽 그룹 (정적 프로필): 순위 · 이름 · 전투력
                       오른쪽 그룹 (실시간 전투): 총딜 · DPS · 지분
                     8px gap 으로 두 그룹 분리. CP 는 이름 옆에 작게 붙음 (LOA Logs 패턴). -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasDungeon, Converter={StaticResource BoolToVis}}">
                        <Rectangle Width="2" Height="10"
                                   Fill="{DynamicResource CyanBrush}"
                                   Opacity="0.7"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentDungeonName}"
                                   Foreground="{DynamicResource CyanBrush}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Opacity="0.95"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="전투력"
                               Foreground="{DynamicResource GoldBrush}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <!-- Col 3 = visual gap between 정적/실시간 그룹 (intentionally empty) -->
                    <TextBlock Grid.Column="4" Text="총딜"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="DPS"
                               Foreground="{DynamicResource CyanBrush}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="12" FontWeight="Bold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="지분"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Leaderboard -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="6,4"
                          Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Players}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- v0.1.2 "Glass Track Meter" — 한 행 안에 누적 데미지 비율을
                                 클래스 색 막대로 시각화. 좌측 stripe = podium (1·2·3 gold/silver/bronze)
                                 또는 self/primary-guess 색. -->
                            <Grid Height="36" Margin="0,1"
                                  Background="Transparent"
                                  MouseLeftButtonUp="PlayerRow_Click"
                                  Cursor="Hand"
                                  ToolTip="클릭 — 스킬 상세 보기">
                                <!-- Layer 1: row tint background (self / primary-guess only) -->
                                <Border CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource RowOverlayBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelfRowBgBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPrimaryGuess}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryGuessRowBgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Layer 2: 좌측 stripe.
                                     Rank 1·2·3 = gold/silver/bronze podium stripe.
                                     Self / primary-guess = green / cyan stripe (rank 위에 덮어 씌움).
                                     Triggers 평가 순서: rank-based triggers 먼저, self/primary 가 last-wins.
                                     Width = 3px (rank/self/primary 통일). -->
                                <Rectangle Width="3"
                                           HorizontalAlignment="Left"
                                           Margin="0,3,0,3"
                                           RadiusX="1" RadiusY="1">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Rank}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Fill" Value="{DynamicResource PodiumGoldBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Rank}" Value="2">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Fill" Value="{DynamicResource PodiumSilverBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Rank}" Value="3">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Fill" Value="{DynamicResource PodiumBronzeBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Fill" Value="{DynamicResource SelfAccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPrimaryGuess}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Fill" Value="{DynamicResource PrimaryGuessAccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>

                                <!-- Layer 3: Glass Track container.
                                     Inset 4px on left (clear of self-stripe), 3px on top/bottom.
                                     반투명 baseline + 1px subtle 외곽선으로 "유리 트랙" 느낌. -->
                                <Border x:Name="GlassTrack"
                                        Background="{DynamicResource GlassTrackBgBrush}"
                                        BorderBrush="{DynamicResource GlassTrackBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="4,3,4,3"
                                        ClipToBounds="True">
                                    <Grid>
                                        <!-- Bar A: 누적 데미지 비율 막대.
                                             기본 = 랭크별 시그니처 색 (디자이너 8색 팔레트, alpha 0x55)
                                             → 1·2·3·4 등이 서로 다른 색이라 한눈에 식별.
                                             본인 행 → SelfDamageBarBrush 로 swap (테마별 자기 색). -->
                                        <Border CornerRadius="2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Stretch"
                                                Background="{Binding Rank, Converter={StaticResource RankToBarBrush}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SelfDamageBarBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource PercentToWidth}">
                                                    <Binding Path="DamageBarPercent"/>
                                                    <Binding Path="ActualWidth"
                                                             RelativeSource="{RelativeSource AncestorType=Border}"/>
                                                </MultiBinding>
                                            </Border.Width>
                                            <!-- Edge highlight: 2px 랭크 색 stripe (alpha 0xCC) at 우측 끝. -->
                                            <Rectangle Width="2" HorizontalAlignment="Right"
                                                       Fill="{Binding Rank, Converter={StaticResource RankToEdgeBrush}}">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SelfDamageBarEdgeBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </Border>

                                    </Grid>
                                </Border>

                                <!-- Layer 4: Text grid on top of bars.
                                     컬럼 구조 (헤더와 픽셀 단위 정확히 일치):
                                       [순위] [이름·아이콘] [전투력] |gap| [총딜] [DPS] [지분]
                                          정적 프로필 그룹 ↑          ↑ 실시간 전투 그룹
                                     숫자는 compact 표기 (23.8M / 241.8K) — 자릿수 균일화로 컬럼 정렬 안정. -->
                                <Grid Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Rank}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding TopSkillsTooltip}">
                                        <Image Source="{Binding ClassIcon}"
                                               Width="22" Height="22"
                                               Margin="0,0,7,0"
                                               VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="Fant"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="{DynamicResource UiFont}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- 전투력: 정적 프로필 정보, 이름 그룹에 속함 -->
                                    <TextBlock Grid.Column="2" Text="{Binding CombatPowerDisplay}"
                                               Foreground="{DynamicResource GoldBrush}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               ToolTip="전투력"/>
                                    <!-- Col 3 = visual gap (intentionally empty) -->
                                    <!-- 총딜: compact 표기 (23.8M) -->
                                    <TextBlock Grid.Column="4" Text="{Binding TotalDamageDisplay}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               ToolTip="총 누적 데미지"/>
                                    <!-- DPS: 시각 중심, compact 표기 (241.8K) -->
                                    <TextBlock Grid.Column="5" Text="{Binding DpsDisplay}"
                                               Foreground="{DynamicResource CyanBrush}"
                                               FontFamily="{DynamicResource MonoFont}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               ToolTip="초당 데미지"/>
                                    <!-- 지분: badge 형식 capsule -->
                                    <Border Grid.Column="6"
                                            Background="{DynamicResource SectionOverlayBrush}"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            Margin="4,5,2,5"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                        <TextBlock
                                            Text="{Binding DamageSharePercent, StringFormat={}{0:F0}%}"
                                            Foreground="{DynamicResource TextBrush}"
                                            FontFamily="{DynamicResource MonoFont}"
                                            FontSize="11"
                                            FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="4" Padding="10,4" Background="{DynamicResource FooterOverlayBrush}"
                    Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SelfAccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TickIndicator}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SelfAccentBrush}"/>
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TickIndicator}" Value="False">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <CheckBox IsChecked="{Binding AutoResetOnBoss}"
                              Content="보스 자동리셋"
                              ToolTip="보스 잡거나 와이프 시 결과 화면 그대로 유지. 다음 보스(또는 같은 보스 재도전)를 처음 타격하는 순간 자동 리셋되어 새 누적 시작. 60초 무전투도 안전망으로 리셋."
                              Foreground="{DynamicResource MutedBrush}"
                              FontFamily="{DynamicResource UiFont}"
                              FontSize="11" VerticalAlignment="Center"
                              DockPanel.Dock="Right"/>
                    <TextBlock Text="" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
