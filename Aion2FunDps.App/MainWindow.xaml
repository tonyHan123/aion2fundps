<Window x:Class="Aion2FunDps.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aion2FunDps.UI.ViewModels;assembly=Aion2FunDps.UI"
        xmlns:ui="clr-namespace:Aion2FunDps.UI;assembly=Aion2FunDps.UI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="aion2fundps"
        Width="420" Height="340"
        MinWidth="360" MinHeight="60"
        MaxWidth="900" MaxHeight="900"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <!-- WindowChrome restores the OS-level edge resize hit zones that
         WindowStyle=None + AllowsTransparency=True strips away. With this,
         hovering over a window edge changes the cursor to ↔ / ↕ / ⤡ and
         dragging resizes — same as a normal Windows window. CaptionHeight=0
         because we have our own custom titlebar (drag handler) and don't
         want WindowChrome's auto-drag interfering with it. UseAeroCaptionButtons
         off + GlassFrameThickness=0 because we draw our own ✕ / ⚙ / etc. -->
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="6"
                      CaptionHeight="0"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Hotkeys are bound at runtime by ApplyHotkeys() (MainWindow.xaml.cs)
         from AppSettings, so the user can rebind them via the settings panel
         without restarting the app. -->

    <Window.Resources>
        <!-- Theme brushes / fonts live in Application.Resources via
             /Themes/Theme.{themeId}.xaml — see App.xaml. ThemeManager
             swaps that at runtime; DynamicResource lookups in this window
             walk up to the application scope and pick up the active theme.
             Window-local resources are only the static converters. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ui:HexColorToBrushConverter x:Key="HexToBrush"/>
        <ui:RankToBarBrushConverter x:Key="RankToBarBrush"/>
        <ui:RankToEdgeBrushConverter x:Key="RankToEdgeBrush"/>
        <ui:PercentToWidthConverter x:Key="PercentToWidth"/>
        <!-- Ambient Glass (2026-06-12): 클래스색 → 입체 램프/팁 브러시 -->
        <ui:ClassRampBrushConverter x:Key="ClassRamp"/>
        <ui:ClassTipBrushConverter x:Key="ClassTip"/>
    </Window.Resources>

    <Border x:Name="OuterBorder"
            Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="LeaderboardRow" Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar (drag) -->
            <Border Grid.Row="0" Padding="2,7,12,7"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <DockPanel>
                    <Image DockPanel.Dock="Left"
                           Source="/Assets/Logo/logo-icon.png"
                           Width="22" Height="22"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="Fant"/>
                    <!-- Game-logo-styled wordmark. WPF text + gradient brush +
                         tiny static DropShadowEffect for the "glowing letters"
                         feel of the source image. The shadow is OK on a static
                         element (renders once, not per-frame); the per-row
                         icon shadow we removed was per-frame. -->
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontFamily="Impact"
                               FontSize="16"
                               FontWeight="Bold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource LogoGlowColor}"
                                              BlurRadius="8"
                                              ShadowDepth="0" Opacity="0.55"/>
                        </TextBlock.Effect>
                        <Run Text="AION" Foreground="{DynamicResource LogoMainBrush}"/><Run Text="2" FontSize="18" Foreground="{DynamicResource LogoAccentBrush}"/><Run Text="FUN" Foreground="{DynamicResource LogoMainBrush}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE706;"
                                   ToolTip="투명도 (왼쪽일수록 투명)"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <Slider Width="80"
                                Minimum="0.2" Maximum="1.0"
                                SmallChange="0.05" LargeChange="0.1"
                                Value="{Binding WindowOpacity, Mode=TwoWay}"
                                ToolTip="투명도 (왼쪽일수록 투명)"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <Button x:Name="UpdateBtn" Click="UpdateBtn_Click"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding UpdateVersionLabel, StringFormat=새 버전 {0} — 클릭하여 업데이트}"
                                Height="22" Padding="6,0" Background="Transparent"
                                Foreground="{DynamicResource AmberBrush}" BorderThickness="0"
                                FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="&#xE7E7;" FontFamily="Segoe MDL2 Assets"/><Run Text="  "/><Run Text="{Binding UpdateVersionLabel}"/>
                            </TextBlock>
                        </Button>
                        <Button x:Name="MarkBtn" Content="&#xE840;" Click="MarkBtn_Click"
                                ToolTip="타임스탬프 기록 (디버그용 — 게임 중 이상 시점 표시)"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        <Button Content="&#xE713;" Click="SettingsBtn_Click"
                                ToolTip="설정 (테마 / 표시 옵션)"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        <Button Content="&#xE72C;" Command="{Binding ResetSessionCommand}"
                                ToolTip="세션 리셋 (Ctrl+R)"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        <Button Content="&#xE921;" Click="MinBtn_Click"
                                ToolTip="컴팩트 모드 토글 (타이틀바만 남기기)"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        <Button Content="&#xE711;" Click="CloseBtn_Click"
                                ToolTip="종료"
                                Width="26" Height="22" Background="Transparent"
                                Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Auto-reset flash banner (briefly visible after boss detection) -->
            <Border Grid.Row="1" Padding="0"
                    Background="{DynamicResource AmberSoftBrush}"
                    Visibility="{Binding ShowAutoResetFlash, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="{DynamicResource AmberBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="보스 감지 — 세션 자동 리셋"
                               Padding="10,5"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AmberBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Confidence + boss banner combined.
                 Hidden while auto-reset flash is showing so the two Row 1 borders
                 don't visually overlap during the brief flash window. -->
            <Border Grid.Row="1" Padding="12,5"
                    Background="{DynamicResource RowOverlayBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsContentVisible}" Value="True"/>
                                    <Condition Binding="{Binding ShowAutoResetFlash}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Confidence (left): only shown while a boss fight is being measured.
                         Hides during idle/town to avoid showing meaningless drift wobble. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                ToolTip="{Binding ConfidenceIssues}"
                                Visibility="{Binding IsConfidenceVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="신뢰도"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="11"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfidenceEmoji}"
                                   FontSize="11"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfidenceScore, StringFormat={}{0:P0}}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Boss name + HP (right). Refined gold matches the in-game
                         stat panel content-marker tone; the previous saturated
                         orange clashed against the deep BG. -->
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Margin="20,0,0,0"
                               Text="{Binding FocusInfo}"
                               Foreground="{DynamicResource GoldBrush}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsBossMode, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- Ambient Glass (2026-06-12): 컬럼 헤더 폐지 — 새 행 레이아웃은 만/억 단위가
                 자체 설명이라 헤더 불필요. 이 줄은 던전 이름 + 파티 로딩 안내 전용. -->
            <Border Grid.Row="2" Padding="12,5,12,4"
                    Background="{DynamicResource SectionOverlayBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasDungeon, Converter={StaticResource BoolToVis}}">
                            <Rectangle Width="2" Height="10"
                                       Fill="{DynamicResource CyanBrush}"
                                       Opacity="0.7"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentDungeonName}"
                                       Foreground="{DynamicResource CyanBrush}"
                                       FontFamily="{DynamicResource UiFont}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Opacity="0.95"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                    Visibility="{Binding IsResolvingParty, Converter={StaticResource BoolToVis}}">
                            <Rectangle Width="2" Height="10"
                                       Fill="{DynamicResource AmberBrush}"
                                       Opacity="0.7"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="파티 정보 불러오는 중..."
                                       Foreground="{DynamicResource AmberBrush}"
                                       FontFamily="{DynamicResource UiFont}"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       VerticalAlignment="Center"
                                       Opacity="0.85"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Leaderboard -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="6,4"
                          Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Players}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Ambient Glass row (2026-06-12 리디자인) — docs/ambient-glass-context.md
                                 원칙: 색=클래스 고정(사람을 따라다님), 순위=위치+포디움 숫자색,
                                 본인=구조(스트로크+▶)로 구분 (클래스색 채널 침범 금지).
                                 막대 = 클래스색 수직 명암 램프(입체) · 길이 = 총딜 비율(1등 대비).
                                 숫자 = Rajdhani, 값/단위 Run 분리 (단위 디밍). -->
                            <Border Height="30" Margin="0,1,0,1"
                                    CornerRadius="5"
                                    ClipToBounds="True"
                                    MouseLeftButtonUp="PlayerRow_Click"
                                    Cursor="Hand"
                                    ToolTip="{Binding TopSkillsTooltip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource GlassRowBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource GlassSelfRowBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource GlassSelfStrokeBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPrimaryGuess}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource GlassSelfRowBgBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource GlassSelfStrokeBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid x:Name="RowRoot">
                                    <!-- Layer 1: 클래스색 입체 막대 (총딜 비율).
                                         수직 램프(위 밝음/아래 어두움) + 상단 1px 글로스 + 끝단 브라이트 팁.
                                         글로우 Effect 는 per-row 프레임 비용이라 미사용 (팁 밝기로 대체). -->
                                    <Border CornerRadius="4,0,0,4"
                                            HorizontalAlignment="Left"
                                            Opacity="0.78"
                                            Background="{Binding BrightClassColorHex, Converter={StaticResource ClassRamp}}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentToWidth}">
                                                <Binding Path="DamageBarPercent"/>
                                                <Binding Path="ActualWidth" ElementName="RowRoot"/>
                                            </MultiBinding>
                                        </Border.Width>
                                        <Grid>
                                            <Border Height="1" VerticalAlignment="Top" Margin="1,1,1,0"
                                                    Background="{DynamicResource BarGlossBrush}"/>
                                            <Border Width="2.5" HorizontalAlignment="Right"
                                                    Background="{Binding BrightClassColorHex, Converter={StaticResource ClassTip}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Layer 2: 텍스트.
                                         [▶+순위][클래스아이콘][이름] = 정체성 / [총딜][DPS][지분칩] = 실시간 -->
                                    <Grid Margin="7,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="54"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <!-- ▶ = 본인 마커 (구조적 본인 구분의 일부) -->
                                            <TextBlock Text="▶" FontSize="8"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,2,0"
                                                       Foreground="{DynamicResource NumPrimaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPrimaryGuess}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- 순위 — 위치가 1차 채널, 1·2·3등만 포디움 색 -->
                                            <TextBlock Text="{Binding Rank}"
                                                       FontFamily="{DynamicResource NumFont}"
                                                       FontSize="12" FontWeight="Bold"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource RankMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Rank}" Value="1">
                                                                <Setter Property="Foreground" Value="{DynamicResource PodiumGoldBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Rank}" Value="2">
                                                                <Setter Property="Foreground" Value="{DynamicResource PodiumSilverBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Rank}" Value="3">
                                                                <Setter Property="Foreground" Value="{DynamicResource PodiumBronzeBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <Image Grid.Column="1"
                                               Source="{Binding ClassIcon}"
                                               Width="18" Height="18"
                                               VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="Fant"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="{DynamicResource UiFont}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- 총딜 (보조 위계) — 값/단위 분리, 단위 디밍 -->
                                        <TextBlock Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Margin="0,0,9,0"
                                                   ToolTip="누적 총딜"><Run Text="{Binding TotalValue, Mode=OneWay}"
                                                 FontFamily="{DynamicResource NumFont}"
                                                 FontSize="11"
                                                 Foreground="{DynamicResource NumSecondaryBrush}"/><Run Text="{Binding TotalUnit, Mode=OneWay}"
                                                 FontFamily="{DynamicResource UiFont}"
                                                 FontSize="8.5"
                                                 Foreground="{DynamicResource NumUnitBrush}"/></TextBlock>

                                        <!-- DPS (히어로 숫자) -->
                                        <TextBlock Grid.Column="4"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   ToolTip="초당 데미지"><Run Text="{Binding DpsValue, Mode=OneWay}"
                                                 FontFamily="{DynamicResource NumFont}"
                                                 FontSize="15" FontWeight="Bold"
                                                 Foreground="{DynamicResource NumPrimaryBrush}"/><Run Text="{Binding DpsUnit, Mode=OneWay}"
                                                 FontFamily="{DynamicResource UiFont}"
                                                 FontSize="10"
                                                 Foreground="{DynamicResource NumUnitBrush}"/></TextBlock>

                                        <!-- 지분 히트 칩 (B-3) — 파티 평균 대비: T2=금(캐리) T1=은 T0=중립 -->
                                        <Border Grid.Column="5"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                Padding="6,0,6,1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                ToolTip="파티 내 데미지 지분">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ChipT0BgBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ChipT0BorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShareTier}" Value="1">
                                                            <Setter Property="Background" Value="{DynamicResource ChipT1BgBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ChipT1BorderBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ShareTier}" Value="2">
                                                            <Setter Property="Background" Value="{DynamicResource ChipT2BgBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ChipT2BorderBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ChipT0TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShareTier}" Value="1">
                                                                <Setter Property="Foreground" Value="{DynamicResource ChipT1TextBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ShareTier}" Value="2">
                                                                <Setter Property="Foreground" Value="{DynamicResource ChipT2TextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style><Run Text="{Binding ShareValue, Mode=OneWay}"
                                                     FontFamily="{DynamicResource NumFont}"
                                                     FontSize="10.5" FontWeight="SemiBold"/><Run Text="%" FontSize="8.5"/></TextBlock>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="4" Padding="10,4" Background="{DynamicResource FooterOverlayBrush}"
                    Visibility="{Binding IsContentVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SelfAccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TickIndicator}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SelfAccentBrush}"/>
                                        <Setter Property="Opacity" Value="1.0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TickIndicator}" Value="False">
                                        <Setter Property="Opacity" Value="0.35"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
