<Application x:Class="Aion2FunDps.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aion2FunDps.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Slot 0: active theme. ThemeManager.ApplyTheme(themeId) swaps
                 this dictionary at runtime; MainWindow's DynamicResource refs
                 walk up to Application.Resources and find the active theme's
                 brushes/fonts. The Default theme is loaded statically so the
                 first paint (before App.OnStartup runs) has correct colors. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Theme.Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
