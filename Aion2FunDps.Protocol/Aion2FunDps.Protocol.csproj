<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Aion2FunDps.Core\Aion2FunDps.Core.csproj" />
    <ProjectReference Include="..\Aion2FunDps.Capture\Aion2FunDps.Capture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NativeEngineDispatcher uses `fixed (byte* p = ...)` to pin the
         managed packet buffer for the duration of the native dispatch
         call. This is the cleanest way to hand a Span<byte> over a
         P/Invoke boundary without an extra copy. Scoped to this project
         only — callers don't see unsafe APIs because the wrapper
         exposes a Dispatch(GamePacket) signature. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
