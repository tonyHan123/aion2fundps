  <ItemGroup>
    <Content Include="Assets\ClassIcons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Logo\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Aion2FunDps.Storage\Data\mobs.json"            Link="Data\mobs.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Aion2FunDps.Storage\Data\skills.json"          Link="Data\skills.json">
