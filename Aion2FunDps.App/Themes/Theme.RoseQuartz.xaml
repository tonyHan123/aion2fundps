<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================
         Theme: Rose Quartz
         ========================================================================
         The "actually pink" alternative to Sweet Pastel. Where SweetPastel
         picked warm taupe + rose accents (and got the 사용자 feedback "이거
         핑크 안 같다"), Rose Quartz makes saturated pink the surface itself
         and pulls accents toward raspberry + rose-gold. Brand reference:
         Pantone "Rose Quartz" (color of the year 2016) — feminine, polished,
         not candy-toned.

         사용자 의도 2026-05-14: "여자들이 좀더 좋아할만한 위와같은 핑크 /
         진짜 전문적인 디자이너가 만든 ui처럼".

         Contrast: deep wine text on saturated rose pink BG passes WCAG AA.
         Alpha 0xED (93%) keeps the meter as a panel laid over the game
         rather than a sticker — a hint of the world bleeds through without
         degrading readability.
         ======================================================================== -->

    <!-- Surfaces -->
    <!-- Saturated rose pink — the brand surface. Slightly toned down from
         pure pink so text doesn't fight the BG; alpha 0xED lets game UI
         glimmer through. -->
    <SolidColorBrush x:Key="BgBrush"            Color="#EDF6B0C8"/>

    <!-- Title bar / borders: deeper rose overlays at modest alpha. -->
    <SolidColorBrush x:Key="TitleBarBrush"      Color="#33E58CA8"/>
    <SolidColorBrush x:Key="BorderBrush"        Color="#44C76A8C"/>
    <SolidColorBrush x:Key="DividerBrush"       Color="#1A8E4960"/>

    <!-- Typography colors -->
    <!-- Deep wine — high-contrast on the rose pink surface, passes AA. -->
    <SolidColorBrush x:Key="TextBrush"          Color="#3B1A28"/>
    <SolidColorBrush x:Key="MutedBrush"         Color="#7A4658"/>

    <!-- Content accents -->
    <!-- Rose-gold for dungeon name / focused boss / medal-style markers.
         Warm enough to bridge pink surface and DPS raspberry. -->
    <SolidColorBrush x:Key="GoldBrush"          Color="#B8853F"/>
    <SolidColorBrush x:Key="GoldDimBrush"       Color="#8B6230"/>
    <!-- 전투력 컬럼 — saturated rose 배경에 deep plum-indigo 가 식별성 + 테마 톤 둘 다 살림. -->
    <SolidColorBrush x:Key="CombatPowerBrush"   Color="#3A2D5C"/>
    <!-- DPS — rose pink 배경에 짙은 청록이 보색으로 또렷. -->
    <SolidColorBrush x:Key="DpsBrush"           Color="#0F4C5C"/>

    <!-- DPS column (CyanBrush slot) — raspberry pink, the brand pop. The
         saturation steps up from the BG so the most important number on
         screen reads as "this is the value you care about". -->
    <SolidColorBrush x:Key="CyanBrush"          Color="#C73E72"/>

    <!-- Auto-reset banner (AmberBrush slot) — softer rose between BG and
         DPS to avoid two equally-loud pinks fighting each other. -->
    <SolidColorBrush x:Key="AmberBrush"         Color="#D85F8A"/>
    <SolidColorBrush x:Key="AmberSoftBrush"     Color="#22D85F8A"/>

    <!-- Typography — same family across themes. One typography choice owned
         at the design-system level keeps "this app's voice" consistent
         regardless of color theme. -->
    <!-- Pretendard 임베드 (2026-06-13) — 미설치 PC에서 Malgun 폴백 문제 해결. -->
    <FontFamily x:Key="UiFont">/Aion2FunDps.App;component/Assets/Fonts/#Pretendard, Malgun Gothic, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Row + section surface overlays. Dark-alpha against the pink BG
         (same low opacity as other themes so the overlay reads as a
         subtle tint, not a heavy stripe). -->
    <SolidColorBrush x:Key="RowOverlayBrush"      Color="#08000000"/>
    <SolidColorBrush x:Key="SectionOverlayBrush"  Color="#0D000000"/>
    <SolidColorBrush x:Key="FooterOverlayBrush"   Color="#0A000000"/>

    <!-- Per-row signature colors. Self = raspberry; primary guess = rose-gold. -->
    <SolidColorBrush x:Key="SelfAccentBrush"          Color="#C73E72"/>
    <SolidColorBrush x:Key="PrimaryGuessAccentBrush"  Color="#B8853F"/>
    <LinearGradientBrush x:Key="SelfRowBgBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#33C73E72" Offset="0"/>
        <GradientStop Color="#14C73E72" Offset="0.45"/>
        <GradientStop Color="#08C73E72" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGuessRowBgBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#2EB8853F" Offset="0"/>
        <GradientStop Color="#12B8853F" Offset="0.45"/>
        <GradientStop Color="#06B8853F" Offset="1"/>
    </LinearGradientBrush>

    <!-- Damage bar — translucent raspberry. -->
    <SolidColorBrush x:Key="DamageBarBrush" Color="#55C73E72"/>
    <!-- 본인 행 전용 — Rose Quartz 의 라즈베리. -->
    <SolidColorBrush x:Key="SelfDamageBarBrush"     Color="#55801B3A"/>
    <SolidColorBrush x:Key="SelfDamageBarEdgeBrush" Color="#CC801B3A"/>
    <SolidColorBrush x:Key="SelfDpsLineBrush"       Color="#E0801B3A"/>

    <!-- Glass Track Meter (v0.1.2) — Rose Quartz raspberry/rose palette. -->
    <SolidColorBrush x:Key="GlassTrackBgBrush"        Color="#14000000"/>
    <SolidColorBrush x:Key="GlassTrackBorderBrush"    Color="#22000000"/>
    <SolidColorBrush x:Key="DamageBarEdgeBrush"       Color="#AADD7AA8"/>
    <SolidColorBrush x:Key="DpsIntensityLineBrush"    Color="#E0C73E72"/>
    <SolidColorBrush x:Key="TrailingGlowBrush"        Color="#55DD7AA8"/>
    <SolidColorBrush x:Key="PodiumGoldBrush"    Color="#B8853F"/>
    <SolidColorBrush x:Key="PodiumSilverBrush"  Color="#9A8B95"/>
    <SolidColorBrush x:Key="PodiumBronzeBrush"  Color="#8B4A2E"/>

    <!-- Rank-별 막대 — HSV 색상환 ~45° 등간격 8색. saturated rose (#F6B0C8) BG
         대비 800/900-shade 톤으로 분리. alpha 0x99 (60%) 로 기존 0x55 (33%) 보다
         더 진하게. 사용자 보고 2026-05-23: 색 너무 흐리고 비슷한 색끼리 식별 어려움. -->
    <SolidColorBrush x:Key="RankBar1Brush"      Color="#997F1D1D"/>  <!-- red 900 -->
    <SolidColorBrush x:Key="RankBar1EdgeBrush"  Color="#FF7F1D1D"/>
    <SolidColorBrush x:Key="RankBar2Brush"      Color="#99155E75"/>  <!-- cyan 800 -->
    <SolidColorBrush x:Key="RankBar2EdgeBrush"  Color="#FF155E75"/>
    <SolidColorBrush x:Key="RankBar3Brush"      Color="#99581C87"/>  <!-- purple 900 -->
    <SolidColorBrush x:Key="RankBar3EdgeBrush"  Color="#FF581C87"/>
    <SolidColorBrush x:Key="RankBar4Brush"      Color="#9914532D"/>  <!-- green 900 -->
    <SolidColorBrush x:Key="RankBar4EdgeBrush"  Color="#FF14532D"/>
    <SolidColorBrush x:Key="RankBar5Brush"      Color="#9992400E"/>  <!-- amber 800 -->
    <SolidColorBrush x:Key="RankBar5EdgeBrush"  Color="#FF92400E"/>
    <SolidColorBrush x:Key="RankBar6Brush"      Color="#991E3A8A"/>  <!-- blue 900 -->
    <SolidColorBrush x:Key="RankBar6EdgeBrush"  Color="#FF1E3A8A"/>
    <SolidColorBrush x:Key="RankBar7Brush"      Color="#999F1239"/>  <!-- rose 900 (vs BG pink) -->
    <SolidColorBrush x:Key="RankBar7EdgeBrush"  Color="#FF9F1239"/>
    <SolidColorBrush x:Key="RankBar8Brush"      Color="#991F2937"/>  <!-- gray 800 -->
    <SolidColorBrush x:Key="RankBar8EdgeBrush"  Color="#FF1F2937"/>

    <!-- ════════════════════════════════════════════════════════════════
         Ambient Glass (2026-06-12 리디자인) — 핑크 BG 용 라이트 글래스 변형.
         행 = 화이트 글래스, 텍스트 = 딥 와인 (테마 TextBrush 계열). -->
    <FontFamily x:Key="NumFont">/Aion2FunDps.App;component/Assets/Fonts/#Rajdhani, Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="GlassRowBgBrush"      Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="GlassSelfRowBgBrush"  Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="GlassSelfStrokeBrush" Color="#803B1A28"/>
    <SolidColorBrush x:Key="BarGlossBrush"        Color="#66FFFFFF"/>

    <SolidColorBrush x:Key="NumPrimaryBrush"      Color="#2B1320"/>
    <!-- 위계는 크기/굵기로 (DPS 15 Bold vs 총딜 11). 색은 진하게 유지 —
         라이트 테마 BG가 반투명(0xED)이라 밝은 게임화면 위에서 옅어져서
         색을 밝히면 묻힘 (사용자 보고 2026-06-13). -->
    <SolidColorBrush x:Key="NumSecondaryBrush"    Color="#5E3346"/>
    <SolidColorBrush x:Key="NumUnitBrush"         Color="#8A5A6E"/>
    <SolidColorBrush x:Key="RankMutedBrush"       Color="#7A4658"/>

    <SolidColorBrush x:Key="ChipT2BgBrush"     Color="#33B8853F"/>
    <SolidColorBrush x:Key="ChipT2BorderBrush" Color="#99B8853F"/>
    <SolidColorBrush x:Key="ChipT2TextBrush"   Color="#6E4F1C"/>
    <SolidColorBrush x:Key="ChipT1BgBrush"     Color="#268E96A3"/>
    <SolidColorBrush x:Key="ChipT1BorderBrush" Color="#668E96A3"/>
    <SolidColorBrush x:Key="ChipT1TextBrush"   Color="#5A6470"/>
    <SolidColorBrush x:Key="ChipT0BgBrush"     Color="#1A3B1A28"/>
    <SolidColorBrush x:Key="ChipT0BorderBrush" Color="#333B1A28"/>
    <SolidColorBrush x:Key="ChipT0TextBrush"   Color="#54303F"/>

    <!-- 전투력 배지 (2026-06-13) — 핑크 테마 = 어두운 프로스트 칩 + 딥와인 텍스트. -->
    <SolidColorBrush x:Key="CpBadgeBgBrush"     Color="#1F000000"/>
    <SolidColorBrush x:Key="CpBadgeBorderBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="CpBadgeTextBrush"   Color="#2B1320"/>
    <!-- 컬럼 헤더 — 반투명 BG 위에서도 또렷하게 진한 와인 (옅은 muted 는 묻힘). -->
    <SolidColorBrush x:Key="ColHeaderBrush"     Color="#5E3346"/>
    <!-- 행 텍스트 글로우 — 클래스색 바 위 어두운 글자가 뜨게. 라이트 테마 = 흰색 글로우. -->
    <Color x:Key="RowTextGlowColor">#FFFFFF</Color>

    <!-- Logo (AION2FUN wordmark) — pink-to-magenta gradient. -->
    <LinearGradientBrush x:Key="LogoMainBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"    Color="#FFE8F0"/>
        <GradientStop Offset="0.55" Color="#E58CA8"/>
        <GradientStop Offset="1"    Color="#9E2E54"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoAccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#C5547D"/>
        <GradientStop Offset="1" Color="#6E1E3E"/>
    </LinearGradientBrush>
    <Color x:Key="LogoGlowColor">#C73E72</Color>

</ResourceDictionary>
